---
import Base from '../layouts/Base.astro';
import Constellation from '../components/Constellation';
import { featured } from '../content';
---
<Base
  title="[YOUR NAME] — Senior Product Designer"
  description="A career in launches and landings. Portfolio of [YOUR NAME], senior product designer."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="shell hero-inner">
      <p class="label">Senior Product Designer</p>
      <h1 id="hero-title">[YOUR NAME]</h1>
      <p class="hero-line">[POSITIONING STATEMENT]</p>
      <p class="hero-sub">
        A career in launches and landings. Scroll to chart the constellations,
        or <a href="#work-index">skip to all work</a>.
      </p>
    </div>

    <p class="scroll-cue" aria-hidden="true">
      <span>begin the descent</span>
      <span class="cue-rule"></span>
    </p>
  </section>

  {featured.map((study, i) => (
    <Constellation study={study} index={i} client:visible={{ rootMargin: '400px' }} />
  ))}

  <section id="work-index" class="placeholder-slot shell" aria-label="All work">
    <p class="label">Phase 2</p>
    <p>Work index grid goes here.</p>
  </section>
</Base>
